{
  "name": "@lumine-code/tree-sitter-regex-sub",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Parses regular-expression replacement templates with Tree-sitter.",
  "main": "bindings/node",
  "types": "bindings/node",
  "repository": "https://github.com/lumine-code/tree-sitter-regex-sub",
  "bugs": "https://github.com/lumine-code/tree-sitter-regex-sub/issues",
  "homepage": "https://github.com/lumine-code/tree-sitter-regex-sub",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@12.2.1",
  "keywords": [
    "tree-sitter",
    "regexp",
    "replacement",
    "substitution",
    "parser",
    "lumine"
  ],
  "files": [
    "bindings/node",
    "grammar.js",
    "src",
    "tree-sitter.json",
    "binding.gyp"
  ],
  "dependencies": {
    "node-addon-api": "^8.9.2",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tree-sitter": "^0.25.1",
    "tree-sitter-cli": "0.27.0",
    "web-tree-sitter": "0.27.1"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.1"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "build": "npm run generate && npm run build:native",
    "build:native": "node-gyp rebuild",
    "build:wasm": "tree-sitter build --wasm -o tree-sitter-regex-sub.wasm",
    "check:format": "prettier --check .",
    "check:generated": "node scripts/check-generated.js",
    "generate": "tree-sitter generate",
    "install": "node-gyp-build",
    "lint": "eslint .",
    "test:wasm": "npm run build:wasm && node --test test/wasm/*.test.js",
    "test": "npm run lint && npm run check:format && npm run check:generated && npm run build:native && node --test bindings/node/binding_test.js test/*.test.js && tree-sitter test"
  }
}
